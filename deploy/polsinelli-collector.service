[Unit]
Description=Polsinelli Euronext quote collector
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/polsinelli-tracker-data
Environment=POLSINELLI_REPO_ROOT=/home/ubuntu/polsinelli-tracker-data
ExecStart=/usr/bin/bash /home/ubuntu/polsinelli-tracker-data/deploy/run-collector.sh
# Keep this above POLSINELLI_COLLECTOR_TIMEOUT_SECONDS (1500s by default) so
# run-collector.sh can stop and remove the Docker container itself.
TimeoutStartSec=1560
TimeoutStopSec=30
KillSignal=SIGTERM
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
