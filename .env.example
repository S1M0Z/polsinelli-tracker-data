# Never commit real credentials. Copy this file to .env locally.
MARKET_DATA_PROVIDER=saxo
SAXO_ENV=sim
SAXO_REDIRECT_URI=http://localhost:8765/callback
SAXO_TOKEN_FILE=.runtime/saxo-token.json

# Permanent local OAuth flow. Keep both values private.
SAXO_APP_KEY=
SAXO_APP_SECRET=

# Optional temporary alternative, for example the Saxo 24-hour token.
SAXO_ACCESS_TOKEN=
SAXO_ACCOUNT_KEY=
