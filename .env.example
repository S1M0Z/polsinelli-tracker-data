# Active provider: no credential is required for Euronext Live public pages.
MARKET_DATA_PROVIDER=euronext
EURONEXT_DEFAULT_MIC=XMLI
EURONEXT_LOCALE=en

# Optional Saxo fallback. Never commit real credentials or token files.
SAXO_ENV=sim
SAXO_ACCESS_TOKEN=
SAXO_ACCOUNT_KEY=
SAXO_APP_KEY=
SAXO_APP_SECRET=
SAXO_REDIRECT_URI=http://localhost:8765/callback
SAXO_TOKEN_FILE=.runtime/saxo-token.json
